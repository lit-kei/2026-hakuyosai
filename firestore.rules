rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validDisplayName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 24;
    }

    function isParticipantCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "displayName",
          "balance",
          "publicId",
          "createdAt",
          "updatedAt"
        ])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.balance == 1000
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches("^[A-Z0-9]{6}$")
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isParticipantProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName",
          "publicId",
          "updatedAt"
        ])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches("^[A-Z0-9]{6}$")
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /password/{passwordId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || isParticipantCreate(userId);
      allow update: if isAdmin() || isParticipantProfileUpdate(userId) || signedIn();
      allow delete: if isAdmin() || signedIn();
    }

    match /publicIds/{publicId} {
      allow read: if true;
      allow create: if signedIn()
        && publicId.matches("^[A-Z0-9]{6}$")
        && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /roomMembers/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /transactions/{transactionId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }
  }
}
